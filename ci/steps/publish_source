#!/usr/bin/env bash

# Replaces the contents of the release target's source repository with the files committed at HEAD, less those that
# are only for our own builds, then commits and tags them as the release. Does nothing if nothing has changed, such as
# when a deploy is re-run.

set -euo pipefail

USAGE="Usage: $0 test|prod"
TARGET=${1:?Missing required argument TARGET. $USAGE}

source ci/release-target "$TARGET"

WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT
OUT=$WORK_DIR/out

git clone --quiet "https://github.com/$SOURCE_REPO.git" "$OUT"
find "$OUT" -mindepth 1 -maxdepth 1 ! -name .git -exec rm -rf {} +
git archive --format=tar HEAD | tar -xf - -C "$OUT"
rm -rf "$OUT/.circleci" "$OUT/integration-tests" "$OUT/private"

cd "$OUT"
git add --all
if git diff --cached --quiet; then
  echo "Nothing has changed since the last release to $SOURCE_REPO"
  exit 0
fi

# Deploys queue rather than cancel, so an older pipeline's approval can land after a newer release. The repository's
# early releases are tagged vX.Y.Z, which would sort above these, so only X.Y.Z tags count.
LATEST=$(git tag --list | grep -xE '[0-9]+\.[0-9]+\.[0-9]+' | sort -V | tail -1 || true)
if [[ -n $LATEST && $(printf '%s\n' "$LATEST" "$VERSION" | sort -V | tail -1) != "$VERSION" ]]; then
  echo "$SOURCE_REPO already has $LATEST, newer than $VERSION: refusing to publish older source over it" >&2
  exit 1
fi

git commit --quiet -m "Release $VERSION"
git tag -a "$VERSION" -m "$VERSION"
git push --atomic origin HEAD:refs/heads/main "refs/tags/$VERSION"
echo "Published $VERSION to https://github.com/$SOURCE_REPO/tree/$VERSION"
