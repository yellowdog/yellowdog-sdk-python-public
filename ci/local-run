#!/usr/bin/env bash

set -euo pipefail
cd "$(dirname "$0")/.."

SUBMIT_VULNERABILITIES=false
RELEASE=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --submit-vulnerabilities) SUBMIT_VULNERABILITIES=true; shift ;;
    --release) RELEASE=true; shift ;;
    *) echo "Unknown argument: $1" >&2; exit 1 ;;
  esac
done

IMAGE=$(grep -oP '(?<=image: ")[^"]+' .circleci/config.yml | head -1)
SRC_DIR="/mnt/project-src"
PROJECT_DIR="/home/circleci/project"

set -a
# shellcheck disable=SC1090
source <(vault kv get -field=.env secret-dev/circleci/bootstrap)
set +a

exec docker run --rm -it \
  -e VAULT_ROLE_ID \
  -e VAULT_SECRET_ID \
  -e "SUBMIT_VULNERABILITIES=$SUBMIT_VULNERABILITIES" \
  -e "RELEASE=$RELEASE" \
  -v "$PWD:$SRC_DIR:ro" \
  -v /var/run/docker.sock:/var/run/docker.sock \
  --group-add "$(stat -c '%g' /var/run/docker.sock)" \
  "$IMAGE" \
  bash -c "mkdir -p '$PROJECT_DIR' && cp -R '$SRC_DIR/.' '$PROJECT_DIR' && cd '$PROJECT_DIR' && exec ci/run"
